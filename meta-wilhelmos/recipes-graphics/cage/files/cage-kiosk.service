[Unit]
Description=Cage Wayland kiosk session
Requires=seatd.service
After=seatd.service systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
Before=graphical.target

[Service]
User=kiosk
Group=kiosk
SupplementaryGroups=video input render seat
Environment=LIBSEAT_BACKEND=seatd
Environment=XDG_RUNTIME_DIR=/run/cage
# Only takes effect when no hardware GL device exists (SimpleDRM fallback):
# lets wlroots use llvmpipe instead of refusing to start a GL renderer.
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
RuntimeDirectory=cage
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
# seatd.service is Type=simple, so After= does not imply its socket exists
# yet; gate on actual readiness (up to 5s) to avoid a first-boot restart.
ExecStartPre=/bin/sh -c 'n=0; while [ ! -S /run/seatd.sock ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n+1)); done'
# The native GPU driver (i915/xe/amdgpu) is a module and can bind long
# after SimpleDRM registers the firmware framebuffer, especially on slow
# boot media. SimpleDRM has no render node, so starting cage against it
# wedges the session in software rendering with no client GL. Wait up to
# 60s for a render node (only native drivers create one), then proceed
# anyway so the SimpleDRM/llvmpipe fallback still boots on unsupported
# GPUs.
ExecStartPre=/bin/sh -c 'n=0; while ! ls /dev/dri/renderD* >/dev/null 2>&1 && [ $n -lt 600 ]; do sleep 0.1; n=$((n+1)); done'
# Stable exec contract (§7): the installed kiosk application package
# provides /usr/libexec/kiosk-app; the session never names a specific app.
ExecStart=/usr/bin/cage -ds -- /usr/libexec/kiosk-app
# `always`, not `on-failure`: the display may only stay down when the
# supervisor itself was told to stop (systemctl stop is never
# auto-restarted). A clean exit — e.g. an out-of-band `kill -TERM`,
# which the app answers with an ordered shutdown and exit 0 — was a
# permanent black screen under on-failure. The operator seat has no
# kill path at all (no exit keys, no in-session terminal); signals are
# admin-only, and even those now only blink the display.
Restart=always
RestartSec=2
# SIGTERM can go unanswered when the seat is disabled (operator on a
# maintenance VT: seatd pauses the DRM FD, frame callbacks stop, the app
# blocks and never observes the signal) — without a bound, shutdown from
# tty2 holds the stop job for the 90s default before SIGKILL. An ordered
# app shutdown takes <1s; anything longer is the wedged case.
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
